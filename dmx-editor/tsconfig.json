{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // ../dmx-client/src/shared is the contract (patch, .show format, preview protocol). It is
  // imported, never copied — there is one definition of each, shared with the client.
  "include": ["src", "test", "../dmx-client/src/shared"]
}
