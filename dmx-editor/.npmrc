# Same reason as bun-server/.npmrc: this project is unrelated to the Unity PSPM (phoria.*) packages,
# so it installs from the public npm registry rather than the repo-global private one (~/.npmrc points
# at the Phoria Verdaccio). Bun reads .npmrc, and it takes precedence over bunfig.toml.
registry=https://registry.npmjs.org
