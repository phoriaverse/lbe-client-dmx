# Sampling videos (milestone 3) — gigabytes, and the show's, not the editor's.
media/*
!media/README.md

# Room models uploaded through the editor — often hundreds of MB. The rig records the path.
models/*
!models/README.md

# A save in flight (written then renamed over project/rig.json).
project/*.tmp
project/sequences/*.tmp

# Local simulator copies of the versioned native scores; regenerate with bun run import:full.
project/pavotube/sequences/full-show-v1-1-*.json
project/pavotube/sequences/*.tmp
