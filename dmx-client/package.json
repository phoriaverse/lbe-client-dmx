{
  "name": "lighting-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LBE lighting client — plays baked .show files to Art-Net pixel fixtures, clock-synced to the control server.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "sim": "bun src/tools/sim-gateway.ts",
    "poll": "bun src/tools/poll.ts",
    "probe": "bun src/tools/probe.ts",
    "make-test-show": "bun src/tools/make-test-show.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
