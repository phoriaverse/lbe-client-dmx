{
  "name": "lighting-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LBE lighting client — plays baked .show files through Art-Net or ENTTEC USB, clock-synced to the control server.",
  "scripts": {
    "build": "bash macos/build.sh",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "sim": "bun src/tools/sim-gateway.ts",
    "poll": "bun src/tools/poll.ts",
    "probe": "bun src/tools/probe.ts",
    "make-test-show": "bun src/tools/make-test-show.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "usb:list": "bun src/tools/list-usb.ts",
    "start:pavotube": "bun src/index.ts --config config.pavotube.json",
    "preview:pavotube": "bun src/index.ts --config config.pavotube.json --output preview --standalone"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "serialport": "13.0.0"
  }
}
